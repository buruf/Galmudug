# Secret required by the scheduled news-fetch endpoint (/api/cron/fetch-news).
# The endpoint refuses to run if this is unset (fail-closed).
CRON_SECRET=change-me-to-a-long-random-string

# Password for the /admin moderation panel (hide/pin stories).
# The admin panel is disabled if this is unset.
ADMIN_PASSWORD=change-me-too

# Canonical site origin, used for hreflang/sitemap/Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://galmudug.com
